<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SwCopilotAddin</AssemblyName>
    <RootNamespace>SwCopilotAddin</RootNamespace>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Emit a COM-registration step on post-build (requires elevated prompt or VS build with regasm) -->
    <RegisterForComInterop>true</RegisterForComInterop>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <!--
    SolidWorksPath: override via an environment variable or a sibling Directory.Build.props.
    Default targets SolidWorks 2021 x64 default install location.
  -->
  <PropertyGroup>
    <SolidWorksPath Condition="'$(SolidWorksPath)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS 2021</SolidWorksPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- SolidWorks 2021 COM interop assemblies — EmbedInteropTypes=false keeps them as separate DLLs,
         which is required because SolidWorks loads them from its own directory at runtime. -->
    <Reference Include="System.Net.Http" />
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksPath)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksPath)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksPath)\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
  </ItemGroup>

  <!-- Legacy WPF UI is dead code; TaskPaneHost.cs is the active WinForms UI. -->
  <ItemGroup>
    <Compile Remove="UI\ChatPanel.xaml.cs" />
    <Page Remove="UI\ChatPanel.xaml" />
  </ItemGroup>

</Project>
