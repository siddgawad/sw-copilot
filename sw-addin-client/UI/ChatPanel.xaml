<UserControl x:Class="SwCopilotAddin.UI.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E"
             FontFamily="Segoe UI"
             FontSize="13"
             MinWidth="280">

    <UserControl.Resources>
        <!-- Scrollbar override for dark theme -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#313244"/>
        </Style>

        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background"   Value="#89B4FA"/>
            <Setter Property="Foreground"   Value="#1E1E2E"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B4D0FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#45475A"/>
                                <Setter Property="Foreground" Value="#6C7086"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Chat history -->
            <RowDefinition Height="*"/>
            <!-- Status bar -->
            <RowDefinition Height="Auto"/>
            <!-- Input row -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#181825" Padding="10,8">
            <TextBlock Text="SW Copilot"
                       Foreground="#CBA6F7"
                       FontWeight="Bold"
                       FontSize="14"/>
        </Border>

        <!-- Chat history -->
        <ScrollViewer Grid.Row="1"
                      x:Name="ChatScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="8,4">
            <ItemsControl x:Name="MessageList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4"
                                Padding="10,8"
                                CornerRadius="8"
                                Background="{Binding Background}"
                                HorizontalAlignment="{Binding Alignment}"
                                MaxWidth="310">
                            <TextBlock Text="{Binding Text}"
                                       Foreground="#CDD6F4"
                                       TextWrapping="Wrap"
                                       FontSize="13"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status bar -->
        <TextBlock Grid.Row="2"
                   x:Name="StatusText"
                   Text="Ready"
                   Foreground="#6C7086"
                   FontSize="11"
                   Margin="10,4"/>

        <!-- Input row -->
        <Grid Grid.Row="3" Margin="8,4,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="InputBox"
                     Background="#313244"
                     Foreground="#CDD6F4"
                     CaretBrush="#CDD6F4"
                     BorderBrush="#45475A"
                     BorderThickness="1"
                     Padding="8,6"
                     VerticalContentAlignment="Center"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     KeyDown="InputBox_KeyDown"
                     ToolTip="Describe what you want SolidWorks to do…"/>

            <Button Grid.Column="1"
                    x:Name="SendButton"
                    Content="Send"
                    Margin="6,0,0,0"
                    Padding="12,7"
                    Style="{StaticResource SendButtonStyle}"
                    Click="SendButton_Click"/>
        </Grid>
    </Grid>
</UserControl>
